<Window x:Class="ReproductorTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reproductor Taskbar"
        Width="318" Height="42"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#343434"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CoverColumn" Width="34"/>
            <ColumnDefinition Width="164"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="CoverBox" Grid.Column="0" Width="28" Height="28" CornerRadius="4"
                Background="#1C1C1C" VerticalAlignment="Center">
            <Grid>
                <Image x:Name="CoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,28,28" RadiusX="4" RadiusY="4"/>
                    </Image.Clip>
                </Image>
                <TextBlock x:Name="CoverFallback" Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="13"
                           Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Margin="5,0,4,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" Text="Cargando..." FontSize="11" FontWeight="SemiBold"
                       Foreground="#F5F7FA" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MetaText" FontSize="9" Foreground="#B8C0CC" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="PrevButton" ToolTip="Anterior" Click="OnPrevious">
                <TextBlock Text="&#xE892;" Style="{StaticResource Glyph}"/>
            </Button>
            <Button x:Name="PlayButton" ToolTip="Reproducir / pausar" Width="32" Click="OnPlayPause">
                <TextBlock x:Name="PlayIcon" Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="12"/>
            </Button>
            <Button x:Name="NextButton" ToolTip="Siguiente" Click="OnNext">
                <TextBlock Text="&#xE893;" Style="{StaticResource Glyph}"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
